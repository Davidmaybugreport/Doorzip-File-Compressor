Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\Doorzip.Archive]
@="Doorzip Archive Container"

[HKEY_CLASSES_ROOT\Doorzip.Archive\DefaultIcon]
@="\"C:\\Program Files\\Doorzip\\extract_handler.exe\",0"

[HKEY_CLASSES_ROOT\Doorzip.Archive\shell\Extract]
@="Extract with Doorzip"

[HKEY_CLASSES_ROOT\Doorzip.Archive\shell\Extract\command]
@="\"C:\\Program Files\\Doorzip\\extract_handler.exe\" \"%1\""

[HKEY_CLASSES_ROOT\.DZi]
@="Doorzip.Archive"

[HKEY_CLASSES_ROOT\.zd]
@="Doorzip.Archive"

[HKEY_CLASSES_ROOT\.dzz]
@="Doorzip.Archive"

[HKEY_CLASSES_ROOT\.DoorZ]
@="Doorzip.Archive"